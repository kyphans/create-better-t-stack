{
  "name": "kps",
  "version": "3.27.0",
  "private": true,
  "author": "Ky Phan",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:cli": "turbo run dev --filter=create-kps",
    "cli": "cd apps/cli && node dist/cli.js",
    "build:cli": "turbo run build --filter=create-kps",
    "lint": "turbo run lint",
    "check": "oxfmt . && oxlint .",
    "prepare": "lefthook install",
    "release": "bun run scripts/release.ts",
    "bump": "bun run scripts/bump-version.ts",
    "canary": "bun run scripts/canary-release.ts",
    "cleanup-previews": "bun run scripts/cleanup-previews.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "changelogithub": "^14.0.0",
    "lefthook": "^2.1.3",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "turbo": "^2.8.14",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*": [
      "bun check"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.10"
}
