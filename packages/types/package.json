{
  "name": "@kps/types",
  "version": "3.27.0",
  "description": "TypeScript types and schemas for create-kps CLI",
  "keywords": [
    "kps",
    "types",
    "schema",
    "typescript"
  ],
  "homepage": "https://kps.pqky.dev/",
  "license": "MIT",
  "author": "Ky Phan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyphans/create-kps.git",
    "directory": "packages/types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.mts",
      "default": "./dist/json-schema.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsdown": "^0.17.2",
    "typescript": "^5.9.3"
  }
}
